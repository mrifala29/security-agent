# ==============================================================================
# Target Server Configuration for Security Hardening Agent
# ==============================================================================
# Salin file ini menjadi .env:
#   cp .env.example .env
# Isi dengan parameter koneksi server Anda.

# Identifier / Alias Server (digunakan untuk penamaan folder/laporan)
SERVER_NAME=production-web-01

# Alamat IP atau Hostname server target
SERVER_HOST=192.168.1.100

# Port SSH (default: 22)
SERVER_PORT=22

# Username remote dengan akses sudo
SERVER_USER=ubuntu

# Path ke SSH Private Key lokal (contoh: ~/.ssh/id_rsa atau ./server.pem)
SERVER_SSH_KEY_PATH=~/.ssh/id_rsa

# (Opsional) Apakah ingin otomatis test koneksi saat audit dimulai: true/false
AUTO_VERIFY_CONNECTION=true
